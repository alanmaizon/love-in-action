# Django
DEBUG=False
SECRET_KEY=generate-a-secure-random-key-here
ALLOWED_HOSTS=api.lovethatgivesback.com,your-ec2-ip

# Database (RDS PostgreSQL)
DATABASE_URL=postgres://ltgb_user:your-password@your-rds-endpoint:5432/ltgb_db

# CORS
CORS_ALLOWED_ORIGINS=https://lovethatgivesback.com,https://www.lovethatgivesback.com
CSRF_TRUSTED_ORIGINS=https://lovethatgivesback.com,https://www.lovethatgivesback.com

# Frontend URL
FRONTEND_URL=https://lovethatgivesback.com

# Stripe (LIVE keys for production)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Love That Gives Back <noreply@lovethatgivesback.com>

# Redis (optional - for caching/celery)
REDIS_URL=redis://your-elasticache-endpoint:6379

# Sentry (optional - for error tracking)
SENTRY_DSN=https://xxx@sentry.io/xxx
