# Django
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Database (optional - defaults to SQLite)
DATABASE_URL=postgres://user:password@host:5432/dbname

# CORS (comma-separated for production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://lovethatgivesback.com

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Frontend URL (for Stripe redirects)
FRONTEND_URL=http://localhost:5173
REDIS_URL=redis://xxx (optional but recommended)
SENTRY_DSN=https://xxx (optional)

# Email (optional - defaults to console backend in debug)
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Love That Gives Back <noreply@lovethatgivesback.com>

# =============================================================================
# AWS Configuration
# =============================================================================

# General
AWS_REGION=eu-west-1

# Cognito (authentication)
AWS_COGNITO_REGION=eu-west-1
AWS_COGNITO_USER_POOL_ID=eu-west-1_XXXXXXXXX
AWS_COGNITO_APP_CLIENT_ID=your-app-client-id

# S3 (static files and uploads)
AWS_S3_BUCKET_NAME=ltgb-assets

# SQS (donation notification queue)
AWS_SQS_DONATION_QUEUE_URL=https://sqs.eu-west-1.amazonaws.com/123456789/ltgb-donations

# DynamoDB (activity log)
AWS_DYNAMODB_ACTIVITY_TABLE=ltgb-activity-log

# CloudWatch (logging)
AWS_CLOUDWATCH_LOG_GROUP=/ltgb/django

# Parameter Store (set to 'true' to load secrets from SSM)
USE_AWS_PARAMETER_STORE=false
